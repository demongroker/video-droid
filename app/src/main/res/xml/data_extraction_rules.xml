<?xml version="1.0" encoding="utf-8"?>
<!-- 2.5.5: nothing leaves the phone. X session cookies (filesDir/cookies.txt), the queue, the
     WebView cookie DB and the diagnostic logs were all eligible for Google Drive auto-backup and
     device-to-device transfer before this file existed. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
