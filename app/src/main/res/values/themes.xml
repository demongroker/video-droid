<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VideoDroid" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/onSecondary</item>
        <item name="android:colorBackground">@color/vd_bg</item>
        <item name="colorSurface">@color/vd_surface</item>
        <item name="colorSurfaceVariant">@color/vd_surface_high</item>
        <item name="colorOnSurface">@color/vd_text</item>
        <item name="colorOnSurfaceVariant">@color/vd_text_dim</item>
        <item name="colorOutline">@color/vd_outline</item>
        <item name="android:windowBackground">@color/vd_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Pill-shaped quality / filter chips -->
    <style name="Widget.VideoDroid.Pill" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">@dimen/corner_pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Card used for progress / jobs -->
    <style name="Widget.VideoDroid.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/vd_surface</item>
        <item name="cardCornerRadius">@dimen/corner_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/vd_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- One type scale, referenced by new and updated layouts. -->
    <style name="Text.VideoDroid.Display" parent="">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/vd_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.VideoDroid.Title" parent="">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/vd_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.VideoDroid.Body" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/vd_text</item>
    </style>

    <style name="Text.VideoDroid.Label" parent="">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/vd_text_dim</item>
    </style>

    <style name="Text.VideoDroid.SectionLabel" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/vd_text_dim</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
</resources>
