<?xml version="1.0" encoding="utf-8"?>
<!--
  Queue is Compose now (ui/QueueScreen.kt). This shell only carries the insets root and the
  shared bottom navigation, which is still the XML bar used by the other tabs.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/queueRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/queueCompose"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include layout="@layout/bottom_nav" />
</LinearLayout>
