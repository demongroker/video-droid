<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vd_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/settingsBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:padding="10dp"
                    android:src="@drawable/ic_queue"
                    app:tint="@color/vd_text_dim" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.02"
                    android:text="Settings"
                    android:textColor="@color/vd_text"
                    android:textSize="26sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="22dp"
                android:letterSpacing="0.08"
                android:text="DOWNLOADS"
                android:textColor="@color/vd_text_dim"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Simultaneous downloads"
                    android:textColor="@color/vd_text"
                    android:textSize="15sp" />

                <Spinner
                    android:id="@+id/parallelSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/batteryButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="Battery"
                android:textAllCaps="false"
                android:textColor="@color/vd_text_dim" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.08"
                android:text="ACCOUNT"
                android:textColor="@color/vd_text_dim"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/loginXButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="Log in to X"
                android:textAllCaps="false"
                android:textColor="@color/vd_text_dim" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearLoginButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="Clear login"
                android:textAllCaps="false"
                android:textColor="@color/vd_text_dim" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.08"
                android:text="SOURCES"
                android:textColor="@color/vd_text_dim"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/localButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="Local video"
                android:textAllCaps="false"
                android:textColor="@color/vd_text_dim" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/myLastButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="My last link"
                android:textAllCaps="false"
                android:textColor="@color/vd_text_dim" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recommendedButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="Recommended settings"
                android:textAllCaps="false"
                android:textColor="@color/vd_text_dim" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.08"
                android:text="PRIVACY"
                android:textColor="@color/vd_text_dim"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/libraryLockButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="Lock the Library"
                android:textAllCaps="false"
                android:textColor="@color/vd_text_dim" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hideGalleryButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="Hide from Gallery"
                android:textAllCaps="false"
                android:textColor="@color/vd_text_dim" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.08"
                android:text="APP"
                android:textColor="@color/vd_text_dim"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/checkUpdateButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="Check update"
                android:textAllCaps="false"
                android:textColor="@color/vd_text_dim" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/changelogButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="Changelog"
                android:textAllCaps="false"
                android:textColor="@color/vd_text_dim" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/engineUpdateButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="Update download engine"
                android:textAllCaps="false"
                android:textColor="@color/vd_text_dim" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/audioOnlyButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="Audio only"
                android:textAllCaps="false"
                android:textColor="@color/vd_text_dim" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/includeTitlesButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="Include page titles in copied log: off"
                android:textAllCaps="false"
                android:textColor="@color/vd_text_dim" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/subtitlesButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="Download subtitles"
                android:textAllCaps="false"
                android:textColor="@color/vd_text_dim" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/subtitleLangButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="Subtitle language"
                android:textAllCaps="false"
                android:textColor="@color/vd_text_dim" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/appearanceButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="Appearance"
                android:textAllCaps="false"
                android:textColor="@color/vd_text_dim" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/aboutButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="About"
                android:textAllCaps="false"
                android:textColor="@color/vd_text_dim" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/copyLogButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="Copy log"
                android:textAllCaps="false"
                android:textColor="@color/vd_text_dim" />

            <TextView
                android:id="@+id/settingsVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:padding="12dp"
                android:text=""
                android:textColor="@color/vd_danger"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
