<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/libraryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vd_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/libraryWrapper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:text="Library"
                android:textColor="@color/vd_text"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/storageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="@color/vd_text_dim"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/storageBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progressBackgroundTint="@color/vd_outline"
                android:progressTint="@color/vd_emerald" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/findDuplicates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:minHeight="40dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                android:text="Find duplicates"
                android:textAllCaps="false"
                android:textColor="@color/vd_emerald"
                android:textSize="13sp" />

                <Button
                    android:id="@+id/librarySort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:minHeight="40dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Sort: newest"
                    android:textAllCaps="false"
                    android:textColor="@color/vd_text_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Stage 4: appears the moment a file is long-pressed. -->
            <LinearLayout
                android:id="@+id/librarySelectionBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/librarySelectionCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 selected"
                    android:textColor="@color/vd_text"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/librarySelShare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:minHeight="40dp"
                    android:text="Share"
                    android:textAllCaps="false"
                    android:textColor="@color/vd_violet_soft"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/librarySelMove"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:minHeight="40dp"
                    android:text="Move"
                    android:textAllCaps="false"
                    android:textColor="@color/vd_text_dim"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/librarySelDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:minHeight="40dp"
                    android:text="Delete"
                    android:textAllCaps="false"
                    android:textColor="@color/vd_danger"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/librarySelClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:minHeight="40dp"
                    android:text="✕"
                    android:textAllCaps="false"
                    android:textColor="@color/vd_text_dim"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <GridView
            android:id="@+id/libraryGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:columnWidth="112dp"
            android:horizontalSpacing="8dp"
            android:numColumns="auto_fit"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="8dp" />

        <TextView
            android:id="@+id/libraryEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Nothing downloaded yet"
            android:textColor="@color/vd_text_dim"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <include layout="@layout/bottom_nav" />
</LinearLayout>
