<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainWrapper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vd_bg"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mainRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <!-- ── Header ────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.02"
                    android:text="VideoDroid"
                    android:textColor="@color/vd_text"
                    android:textSize="26sp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/dot_emerald" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ready"
                    android:textColor="@color/vd_text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ── Paste / URL bar ───────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.VideoDroid.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="4dp">

                    <EditText
                        android:id="@+id/urlInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Paste a video link"
                        android:imeOptions="actionGo"
                        android:inputType="textUri"
                        android:maxLines="2"
                        android:minHeight="52dp"
                        android:textColor="@color/vd_text"
                        android:textColorHint="@color/vd_text_dim"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/pasteButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Paste from clipboard"
                        android:padding="11dp"
                        android:src="@drawable/ic_paste"
                        app:tint="@color/vd_violet_soft" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Download button ───────────────────────────────────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/goButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="Download"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:backgroundTint="@color/vd_violet"
                app:cornerRadius="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:text="Cancel current"
                android:textAllCaps="false"
                android:textColor="@color/vd_danger"
                android:visibility="gone" />

            <!-- ── Quality pills ─────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.08"
                android:text="QUALITY"
                android:textColor="@color/vd_text_dim"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/qualityPills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/q4k"
                    style="@style/Widget.VideoDroid.Pill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="4K" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/q1080"
                    style="@style/Widget.VideoDroid.Pill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1080" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/q720"
                    style="@style/Widget.VideoDroid.Pill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="720" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/q480"
                    style="@style/Widget.VideoDroid.Pill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="480" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Backing store for the pill selection; never shown. -->
            <Spinner
                android:id="@+id/dlQuality"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />

            <!-- ── Progress card ─────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/jobCard"
                style="@style/Widget.VideoDroid.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/jobThumb"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:background="@color/vd_surface_high"
                            android:contentDescription="Thumbnail"
                            android:scaleType="centerCrop" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="Starting…"
                                android:textColor="@color/vd_text"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/jobSpeed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textColor="@color/vd_emerald"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/jobEta"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:text=""
                                    android:textColor="@color/vd_text_dim"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/jobProgress"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="14dp"
                        android:max="100"
                        android:visibility="gone"
                        app:indicatorColor="@color/vd_violet"
                        app:trackColor="@color/vd_outline"
                        app:trackThickness="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Options sheet trigger ─────────────────────────────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/optionsButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="Options"
                android:textAllCaps="false"
                app:cornerRadius="16dp"
                app:strokeColor="@color/vd_outline" />

            <!-- Hidden host for the advanced controls moved into the sheet. -->
            <LinearLayout
                android:id="@+id/exportOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- ── Presets (collapsed) ───────────────────────────────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/presetsToggle"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Presets"
                android:textAllCaps="false"
                android:textColor="@color/vd_text_dim" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/presetsExpanded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/presetX"
                        style="@style/Widget.VideoDroid.Pill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="X" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/presetTikTok"
                        style="@style/Widget.VideoDroid.Pill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="TikTok" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/presetShorts"
                        style="@style/Widget.VideoDroid.Pill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Shorts" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/presetReels"
                        style="@style/Widget.VideoDroid.Pill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Reels" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/presetInstagram"
                        style="@style/Widget.VideoDroid.Pill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Instagram" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/presetYouTube"
                        style="@style/Widget.VideoDroid.Pill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="YouTube" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/presetFacebook"
                        style="@style/Widget.VideoDroid.Pill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Facebook" />
                </LinearLayout>
            </com.google.android.material.chip.ChipGroup>

            <!-- ── More (collapsed) ──────────────────────────────────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/moreToggle"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="More"
                android:textAllCaps="false"
                android:textColor="@color/vd_text_dim" />

            <LinearLayout
                android:id="@+id/moreSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Export -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Convert for social"
                        android:textColor="@color/vd_text"
                        android:textSize="14sp" />

                    <android.widget.Switch
                        android:id="@+id/exportSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Aspect -->
                <LinearLayout
                    android:id="@+id/aspectRatioRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/aspectMode"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1" />

                    <Spinner
                        android:id="@+id/aspectRatio"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- Trim -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Trim"
                        android:textColor="@color/vd_text"
                        android:textSize="14sp" />

                    <android.widget.Switch
                        android:id="@+id/trimSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/trimOnOff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text=""
                        android:textColor="@color/vd_text_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/trimFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/trimStart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="0:00"
                        android:inputType="text"
                        android:textColor="@color/vd_text"
                        android:textColorHint="@color/vd_text_dim" />

                    <EditText
                        android:id="@+id/trimEnd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:hint="end"
                        android:inputType="text"
                        android:textColor="@color/vd_text"
                        android:textColorHint="@color/vd_text_dim" />
                </LinearLayout>

                <!-- Parallel downloads -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Simultaneous downloads"
                        android:textColor="@color/vd_text"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/parallelSpinner"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp" />
                </LinearLayout>

                <!-- Battery -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/batteryButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:text="Battery"
                    android:textAllCaps="false"
                    android:textColor="@color/vd_text_dim" />

                <!-- Sources -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/localButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:text="Local video"
                    android:textAllCaps="false"
                    android:textColor="@color/vd_text_dim" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openPageButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:text="Open page"
                    android:textAllCaps="false"
                    android:textColor="@color/vd_text_dim" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/myLastButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:text="My last link"
                    android:textAllCaps="false"
                    android:textColor="@color/vd_text_dim" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/recommendedButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:text="Recommended settings"
                    android:textAllCaps="false"
                    android:textColor="@color/vd_text_dim" />

                <!-- Account -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginXButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:text="Log in to X"
                    android:textAllCaps="false"
                    android:textColor="@color/vd_text_dim" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearLoginButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:text="Clear login"
                    android:textAllCaps="false"
                    android:textColor="@color/vd_text_dim" />

                <!-- Library -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/libraryButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:text="Library"
                    android:textAllCaps="false"
                    android:textColor="@color/vd_text_dim" />

                <!-- Diagnostics -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/copyLogButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:text="Copy log"
                    android:textAllCaps="false"
                    android:textColor="@color/vd_text_dim" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/checkUpdateButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:text="Check update"
                    android:textAllCaps="false"
                    android:textColor="@color/vd_text_dim" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/changelogButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:text="Changelog"
                    android:textAllCaps="false"
                    android:textColor="@color/vd_text_dim" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNavHost"
        layout="@layout/bottom_nav" />
</LinearLayout>
