<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainWrapper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vd_bg"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mainRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <!-- ── Header ────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.02"
                    android:text="VideoDroid"
                    android:textColor="@color/vd_text"
                    android:textSize="26sp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/dot_emerald" />

                <TextView
                    android:id="@+id/statePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="ready"
                    android:textColor="@color/vd_text_dim"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/settingsButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Settings"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/vd_text_dim" />
            </LinearLayout>

            <!-- ── Paste / URL bar ───────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.VideoDroid.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="4dp">

                    <EditText
                        android:id="@+id/urlInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Paste a video link"
                        android:imeOptions="actionGo"
                        android:inputType="textUri"
                        android:maxLines="2"
                        android:minHeight="52dp"
                        android:textColor="@color/vd_text"
                        android:textColorHint="@color/vd_text_dim"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/pasteButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Paste from clipboard"
                        android:padding="11dp"
                        android:src="@drawable/ic_paste"
                        app:tint="@color/vd_violet_soft" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stage 2: clipboard detect — explicit "Download this?" consent, no auto-start. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/clipboardBanner"
                style="@style/Widget.VideoDroid.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Download this?"
                            android:textColor="@color/vd_text"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/clipboardBannerText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:text=""
                            android:textColor="@color/vd_text_dim"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clipboardBannerGo"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Download"
                        android:textAllCaps="false"
                        android:textColor="@color/vd_violet_soft" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clipboardBannerClose"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="40dp"
                        android:text="✕"
                        android:textColor="@color/vd_text_dim" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- One-time banner after a crash: the log is on disk, never uploaded. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/crashBanner"
                style="@style/Widget.VideoDroid.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="VideoDroid crashed last time — view log?"
                        android:textColor="@color/vd_text"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/crashBannerView"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View"
                        android:textAllCaps="false"
                        android:textColor="@color/vd_violet_soft" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/crashBannerDismiss"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="40dp"
                        android:text="✕"
                        android:textColor="@color/vd_text_dim" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Download button ───────────────────────────────────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/goButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="Download"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:backgroundTint="@color/vd_violet"
                app:cornerRadius="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:text="Cancel current"
                android:textAllCaps="false"
                android:textColor="@color/vd_danger"
                android:visibility="gone" />

            <!-- ── Quality pills ─────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.08"
                android:text="QUALITY"
                android:textColor="@color/vd_text_dim"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/qualityPills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/q4k"
                    style="@style/Widget.VideoDroid.Pill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="4K" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/q1080"
                    style="@style/Widget.VideoDroid.Pill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1080" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/q720"
                    style="@style/Widget.VideoDroid.Pill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="720" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/q480"
                    style="@style/Widget.VideoDroid.Pill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="480" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Backing store for the pill selection; never shown. -->
            <Spinner
                android:id="@+id/dlQuality"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />

            <!-- ── Progress card ─────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/jobCard"
                style="@style/Widget.VideoDroid.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/jobThumb"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:background="@color/vd_surface_high"
                            android:contentDescription="Thumbnail"
                            android:scaleType="centerCrop" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="Starting…"
                                android:textColor="@color/vd_text"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/jobSpeed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textColor="@color/vd_emerald"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/jobEta"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:text=""
                                    android:textColor="@color/vd_text_dim"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/jobProgress"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="14dp"
                        android:max="100"
                        android:visibility="gone"
                        app:indicatorColor="@color/vd_violet"
                        app:trackColor="@color/vd_outline"
                        app:trackThickness="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Options sheet trigger ─────────────────────────────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/optionsButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="Options"
                android:textAllCaps="false"
                app:cornerRadius="16dp"
                app:strokeColor="@color/vd_outline" />

            <!-- Generic page scan: offers the videos found on a page instead of guessing. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/scanPageButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="Scan page for videos"
                android:textAllCaps="false"
                android:textColor="@color/vd_violet_soft" />

            <!--
                Social presets: one sideways-scrolling row of chips (Stage 1). No toggle, no
                "More" section — everything advanced lives in the Options sheet and Settings.
            -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/presetsExpanded"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetX"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="X" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetTikTok"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TikTok" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetShorts"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shorts" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetReels"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reels" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetInstagram"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Instagram" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetYouTube"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YouTube" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetFacebook"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Facebook" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!--
                Hidden host: the re-encode / aspect / trim state still lives here so the
                Options sheet and the saved preferences keep one source of truth, but none of
                it is visible on the Download screen any more (Stage 1).
            -->
            <LinearLayout
                android:id="@+id/exportOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <android.widget.Switch
                    android:id="@+id/exportSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/aspectRatioRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/aspectMode"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1" />

                    <Spinner
                        android:id="@+id/aspectRatio"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <android.widget.Switch
                    android:id="@+id/trimSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/trimOnOff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="" />

                <LinearLayout
                    android:id="@+id/trimFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/trimStart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="text" />

                    <EditText
                        android:id="@+id/trimEnd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="text" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openPageButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open page"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- No android:id here: an include id would override the included root's
         id (bottomNav) and findViewById(R.id.bottomNav) would return null. -->
    <include layout="@layout/bottom_nav" />
</LinearLayout>
