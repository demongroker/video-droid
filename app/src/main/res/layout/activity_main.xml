<?xml version="1.0" encoding="utf-8"?>
<!--
  Download (Main) is Compose now (ui/MainScreen.kt). This shell only carries the insets root
  and the shared bottom navigation, which is still the XML bar used by the other tabs.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainWrapper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/mainCompose"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- No android:id here: an include id would override the included root's
         id (bottomNav) and findViewById(R.id.bottomNav) would return null. -->
    <include layout="@layout/bottom_nav" />
</LinearLayout>