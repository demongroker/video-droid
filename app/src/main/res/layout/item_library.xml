<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/libThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/vd_surface_high"
            android:contentDescription="Video thumbnail"
            android:minHeight="76dp"
            android:scaleType="centerCrop" />

        <!-- Stage 4: size and duration read straight off the thumbnail. -->
        <TextView
            android:id="@+id/libSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="3dp"
            android:background="#99000000"
            android:paddingStart="5dp"
            android:paddingTop="1dp"
            android:paddingEnd="5dp"
            android:paddingBottom="1dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/libDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="3dp"
            android:background="#99000000"
            android:paddingStart="5dp"
            android:paddingTop="1dp"
            android:paddingEnd="5dp"
            android:paddingBottom="1dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <!-- Long-press selection state. -->
        <View
            android:id="@+id/libSelectedOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#8C3B1F6E"
            android:visibility="gone" />

        <TextView
            android:id="@+id/libCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/libName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textColor="@color/vd_text_dim"
        android:textSize="11sp" />
</LinearLayout>
