<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/crashLogsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vd_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/crashLogsBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="10dp"
            android:src="@drawable/ic_queue"
            app:tint="@color/vd_text_dim" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Crash logs"
            android:textColor="@color/vd_text"
            android:textSize="22sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/crashLogsClear"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear all"
            android:textAllCaps="false"
            android:textColor="@color/vd_danger" />
    </LinearLayout>

    <TextView
        android:id="@+id/crashLogsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="No crash logs. Nothing has gone wrong."
        android:textColor="@color/vd_text_dim"
        android:textSize="13sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/crashLogsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/vd_outline"
        android:dividerHeight="1dp"
        android:paddingBottom="20dp" />

    <!-- Viewer: fills the screen when a log is opened. -->
    <LinearLayout
        android:id="@+id/crashLogViewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vd_bg"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/crashViewerBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_queue"
                app:tint="@color/vd_text_dim" />

            <TextView
                android:id="@+id/crashViewerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/vd_text"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/crashViewerCopy"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Copy"
                android:textAllCaps="false"
                android:textColor="@color/vd_violet_soft" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/crashViewerShare"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share"
                android:textAllCaps="false"
                android:textColor="@color/vd_violet_soft" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/crashViewerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text=""
                android:textColor="@color/vd_text"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
