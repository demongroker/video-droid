<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vd_shimmer_base" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:centerColor="@color/vd_shimmer_highlight"
                android:endColor="#001C1C1E"
                android:startColor="#003B1F6E"
                android:type="linear" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
